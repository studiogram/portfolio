{
    "name": "studiogram",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "tailwind": "tailwindcss -i assets/css/tailwind.css -o assets/css/tailwind.build.css --minify",
        "tailwind:watch": "tailwindcss -i assets/css/tailwind.css -o assets/css/tailwind.build.css --minify --watch --poll",
        "clean": "rm -rf dist/js/chunks",
        "dev": "npm run clean && concurrently \"npm run tailwind:watch\" \"CHOKIDAR_USEPOLLING=true vite build --watch\" \"browser-sync start --config bs-config.cjs\"",
        "build": "npm run clean && npm run tailwind && vite build",
        "format:classes": "rustywind --write blocks views"
    },
    "dependencies": {
        "@splinetool/runtime": "^1.12.97",
        "@unseenco/taxi": "^1.9.1",
        "@wordpress/block-editor": "^15.14.0",
        "@wordpress/data": "^10.41.0",
        "cannon-es": "^0.20.0",
        "gsap": "^3.14.2",
        "html2canvas": "^1.4.1",
        "lazysizes": "^5.3.2",
        "lenis": "^1.3.26",
        "masonry-layout": "^4.2.2",
        "plyr": "^3.8.4",
        "swiper": "^12.1.2",
        "three": "^0.186.1"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.2.1",
        "autoprefixer": "^10.4.27",
        "browser-sync": "^3.0.4",
        "concurrently": "^9.1.2",
        "postcss": "^8.5.8",
        "prettier": "^3.9.4",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "rustywind": "^0.28.0",
        "sass": "^1.98.0",
        "tailwindcss": "^4.2.1",
        "vite": "^6.3.0"
    }
}
