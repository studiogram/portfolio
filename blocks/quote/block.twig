{% set has_title = fields.quote.title is not empty %}

<section {{ block_id }} data-block-type="image" data-block-id="{{ block.id }}" class="{{ block_classes(fields) }} {% if fields.background %} overflow-hidden rounded-4xl {% endif %}">
	{% include 'views/partials/block/borders.twig' %}
	<div class="content-grid content-grid--large">
		<div class="flex flex-col gap-8 lg:flex-row lg:items-{{ fields.image.vertical }} lg:gap-16">

			<div class="quote__content {% if has_title %} quote__content--hastitle {% endif %} | py-12 lg:flex-1 {{ fields.image.horizontal == 'right' ? 'lg:order-1' : 'lg:order-2' }}">
				{% if has_title %}
					<p class="quote__title | mb-6 text-md font-bold">{{ fields.quote.title }}</p>
				{% endif %}

				<blockquote class="quote__body">
					{% if fields.quote.quote %}
						<div class="quote__citation | wysiwyg">{{ fields.quote.quote }}</div>
					{% endif %}
					{% if fields.quote.author or fields.quote.author2 %}
						<footer class="quote__author">
							{% if fields.quote.author %}
								<span class="font-bold">{{ fields.quote.author }}</span>
							{% endif %}
							{% if fields.quote.author2 %}
								<span>{{ fields.quote.author2 }}</span>
							{% endif %}
						</footer>
					{% endif %}
				</blockquote>
			</div>

			{% if fields.image.image %}
				<figure class="quote__figure | {% if fields.image.size %} lg:w-5/12 {% else %} lg:w-1/3 {% endif %} {{ fields.image.horizontal == 'right' ? 'lg:order-2' : 'lg:order-1' }}">
					{{ include('views/components/reveal-image/view.twig', { image: fields.image.image, class: 'quote__image | rounded-3xl' }) }}

					{% if fields.image.legend or fields.image.legend2 %}
						{% set bg = background(fields.image.background) %}
						<figcaption class="text-s mt-4 flex flex-col rounded-3xl px-8 pt-8 pb-4 {{ bg.class }} {{ bg.text }}" style="{{ bg.style }}" {% if bg.type %} data-component="gradient" {% endif %}>
							{% if fields.image.legend %}
								<span class="font-bold">{{ fields.image.legend }}</span>
							{% endif %}
							{% if fields.image.legend2 %}
								<span>{{ fields.image.legend2 }}</span>
							{% endif %}
						</figcaption>
					{% endif %}
				</figure>
			{% endif %}

		</div>
	</div>
</section>
