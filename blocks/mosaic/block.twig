<section {{ block_id }} data-block-type="mosaic" data-block-id="{{ block.id }}" class="{{ block_classes(fields) }}">
	{% include 'views/partials/block/borders.twig' %}
	<div class="mosaic pt-12 content-grid">
		{% for column in fields.columns %}
			<div class="mosaic__col {{ loop.index is even ? 'mosaic__col--offset' }}">
				{% for media in column.medias %}
					{% if media.image %}
						<figure class="mosaic__media">
							<img class="mosaic__asset" {{ responsive_image(media.image) }} alt=""/>
						</figure>
					{% endif %}
				{% endfor %}
			</div>
		{% endfor %}
	</div>
</section>
