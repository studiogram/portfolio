<section {{ block_id }} data-block-type="split" data-block-id="{{ block.id }}" class="{{ block_classes(fields) }} split">
	{% include 'views/partials/block/borders.twig' %}

	<div data-scroll="split" class="col-span-12 grid items-stretch px-6! lg:col-span-20 lg:col-start-3 lg:grid-cols-2 lg:px-0!">
		{% if fields.image %}
			<figure data-split="left" class="relative z-10 order-1 overflow-hidden rounded-t-[2rem] lg:rounded-t-none lg:rounded-l-[2rem]">
				<span class="bg-medium absolute top-4 left-4 z-10 size-4 rounded-full lg:top-6 lg:left-6 lg:size-5" aria-hidden="true"></span>
				<span class="bg-medium absolute top-4 right-4 z-10 size-4 rounded-full lg:top-auto lg:right-auto lg:bottom-6 lg:left-6 lg:size-5" aria-hidden="true"></span>
				<img class="lazyload block h-full min-h-72 w-full rounded-[2rem] object-cover" {{ responsive_image(fields.image) }} alt=""/>
			</figure>
		{% endif %}

		<div data-split="right" class="bg-light text-dark relative z-0 order-2 flex flex-col justify-center gap-6 rounded-b-[2rem] px-8! py-12 lg:rounded-r-[2rem] lg:rounded-b-none lg:px-12! lg:py-16">
			{% if fields.title %}<h2 class="text-xxl max-w-[14ch]">{{ fields.title }}</h2>{% endif %}
			{% if fields.text %}<div class="wysiwyg text-soft">{{ fields.text }}</div>{% endif %}
		</div>
	</div>
</section>
