<section {{ block_id }} data-block-type="labo-project" data-block-id="{{ block.id }}" class="{{ block_classes(fields) }} labo-project{{ fields.flip ? ' labo-project--flip' : '' }}">
	{% include 'views/partials/block/borders.twig' %}

	<div class="grider">
		<div class="col-start-2 col-end-12 lg:col-start-2 lg:col-end-24">
			<div class="labo-project__wrap mx-auto max-w-375">
				<div class="labo-project__aside">
					<div class="labo-project__intro">
						{% if fields.title or fields.subtitle %}
							<div class="labo-project__head">
								{% if fields.title %}
									<div class="labo-project__eyebrow flex flex-col">
										<span class="text-tag bg-lightblue text-dark! w-fit rounded-t-xl px-4 py-2 uppercase">{{ fields.title }}</span>
										<span class="border-lightblue block border-t" aria-hidden="true"></span>
									</div>
								{% endif %}
								{% if fields.subtitle %}<h2 class="labo-project__heading" data-effect="headline">{{ fields.subtitle }}</h2>{% endif %}
							</div>
						{% endif %}

						{% if fields.description %}<div class="wysiwyg labo-project__desc">{{ fields.description }}</div>{% endif %}
						{% if fields.tags %}<p class="labo-project__tags text-medium-teriary text-s opacity-60">{{ fields.tags }}</p>{% endif %}


						{% if fields.btn.text %}{{ include('views/components/button/view.twig', { button: fields.btn }) }}{% endif %}

						{% if fields.client_project %}
							<div class="labo-project__case | bg-medium-secondary">
								<span class="labo-project__case-arrow" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 6v6a2 2 0 0 0 2 2h9M14 10l4 4-4 4"/></svg>
								</span>
								{% if fields.client_label %}<p class="labo-project__case-text">{{ fields.client_label }}</p>{% endif %}
								<a href="{{ function('get_permalink', fields.client_project) }}" class="btn btn--secondary labo-project__case-btn" data-taxi-ignore>
									<span>Voir {{ function('get_the_title', fields.client_project) }}</span>
								</a>
							</div>
						{% endif %}

					</div>
				</div>

				<div class="labo-project__media">
					{% if fields.intro_media.image or fields.intro_media.video %}
						<figure class="labo-project__tile">{% include 'views/partials/labo/media.twig' with { m: fields.intro_media } only %}</figure>
					{% endif %}
					{% for sec in fields.sections %}
						{% for it in sec.items %}
							{% if it.image or it.video %}
								<figure class="labo-project__tile">{% include 'views/partials/labo/media.twig' with { m: it } only %}</figure>
							{% endif %}
						{% endfor %}
					{% endfor %}
				</div>
			</div>
		</div>
	</div>
</section>
