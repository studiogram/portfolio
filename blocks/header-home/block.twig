<section {{ block_id }} data-block-type="header-home" data-block-id="{{ block.id }}" class="{{ block_classes(fields, true) }}">
	<div data-scroll="perspective" class="grider gap-y-8! overflow-hidden rounded-4xl content-grid content-grid--full lg:gap-y-12!">
		{% if fields.title %}<h1 class="col-span-12 text-center md:px-6! md:text-left lg:col-span-20 lg:col-start-2 lg:pt-12! lg:pl-12! xxl:col-span-18" data-effect="headline">{{ fields.title }}</h1>{% endif %}
		<div class="col-span-12 flex flex-col gap-6 px-6! lg:col-span-9 lg:col-start-2! lg:gap-12 lg:pb-20 lg:pl-12! xl:col-span-11 xxl:col-span-10">
			{% if fields.intro %} <div class="wysiwyg text-soft-light text-center md:text-left lg:max-w-100">{{ fields.intro }}</div>{% endif %}
			{% if categories %}
				<ul class="-ml-3! flex flex-col gap-0.5 lg:gap-1.5 lg:pb-12 xl:flex-row xl:flex-nowrap">
					{% for cat in categories %}
						<li class="shrink-0">
							<a href="{{ cat.url }}" data-sector="{{ cat.color }}" class="text-m text-light! hover:bg-soft/20! flex items-center gap-3 rounded-xl px-3 transition-[background-color,opacity] duration-500 lg:py-2">
								<span class="size-2.5 shrink-0 rounded-full bg-{{ cat.color }}"></span>
								<span class="shrink-0">{{ cat.title }}</span>
							</a>
						</li>
					{% endfor %}
				</ul>
			{% endif %}
		</div>
		<div class="col-span-12 flex items-end justify-end lg:col-span-13 lg:col-start-12 xl:col-span-11 xl:col-start-14">
			{{ include('views/svg/home.twig') }}
		</div>
	</div>
</section>
