<section {{ block_id }} data-block-type="header-home" data-block-id="{{ block.id }}" class="{{ block_classes(fields, true) }}">
	<div class="cartouche content-grid content-grid--full grider gap-12!" data-scroll="perspective">
		{% if fields.title %}<h1 class="col-start-4 col-span-17 pt-24!" data-effect="headline">{{ fields.title }}</h1>{% endif %}
		{% if fields.intro %}<div class="col-start-4 col-span-8 wysiwyg pb-30 text-soft-light">{{ fields.intro }}</div>{% endif %}
		<div class="col-start-13 col-span-12 flex items-end justify-end">
			{{ include('views/svg/home.twig') }}
		</div>
	</div>
</section>
