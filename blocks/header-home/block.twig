<section {{ block_id }} data-block-type="header-home" data-block-id="{{ block.id }}" class="{{ block_classes(fields, true) }}">
	<div class="cartouche content-grid content-grid--full grider gap-12!" data-scroll="perspective">
		{% if fields.title %}<h1 class="col-start-3 col-span-18 pt-24!">{{ fields.title }}</h1>{% endif %}
		{% if fields.intro %}<div class="col-start-3 col-span-7 wysiwyg pb-30">{{ fields.intro }}</div>{% endif %}
		<div class="col-start-11 col-span-14 flex items-end justify-end">
			{{ include('views/svg/home.twig', {class: 'max-w-[900px]'}) }}
		</div>
	</div>
</section>
