<section {{ block_id }} data-block-type="button" data-block-id="{{ block.id }}" class="{{ block_classes(fields) }}">
	{% include 'views/partials/block/borders.twig' %}
	<div class="content-grid {{ fields.orientation == 'center' ? 'content-grid--center' }}">
		<div class="flex flex-col gap-8 {{ fields.orientation == 'center' ? 'items-center text-center' }}">
			{% if fields.text %}<div class="wysiwyg">{{ fields.text }}</div>{% endif %}
			{{ include('views/components/button/view.twig', { button: fields.btn }) }}
		</div>
	</div>
</section>
