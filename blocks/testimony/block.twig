<section {{ block_id }} data-block-type="testimony" data-block-id="{{ block.id }}" class="{{ block_classes(fields) }} relative">
	{% include 'views/partials/block/borders.twig' %}
	<div class="pointer-events-none absolute inset-0 h-full bg-linear-to-b from-current/10 to-transparent text-{{ sector_color }}" aria-hidden="true"></div>
	<div class="relative content-grid">
		<blockquote class="mx-auto flex max-w-[920px] gap-4">
			<span class="mb-8 text-{{ sector_color }}" aria-hidden="true">{{ include('views/svg/quote-mark.twig', { class: '!w-[48px] h-auto' }) }}</span>
			<div class="flex flex-col pt-6">
				{% if fields.quote %}
					<div class="text-m text-dark max-w-[900px] font-medium">{{ fields.quote }}</div>
				{% endif %}

				{% if fields.author or fields.role %}
					<footer class="text-dark mt-6 flex flex-col items-start text-xs">
						{% if fields.author %}<span class="text-{{ sector_color }}-dark">{{ fields.author }}</span>{% endif %}
						{% if fields.role %}<span class="border-b-2 pb-1 border-{{ sector_color }} text-{{ sector_color }}-dark">{{ fields.role }}</span>{% endif %}
					</footer>
				{% endif %}
			</div>
		</blockquote>
	</div>
</section>
