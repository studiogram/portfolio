<section {{ block_id }} data-block-type="before-after" data-block-id="{{ block.id }}" class="{{ block_classes(fields) }}">
	{% include 'views/partials/block/borders.twig' %}
	<div class="content-grid">
		<div class="mx-auto w-full max-w-4xl">
			{% if fields.label_before or fields.label_after %}
				<div class="text-s mb-4 flex justify-between">
					<span>{{ fields.label_before }}</span>
					<span>{{ fields.label_after }}</span>
				</div>
			{% endif %}

			<div class="before-after relative overflow-hidden rounded-3xl select-none" style="--pos: 50%">
				{% if fields.before %}
					<img class="lazyload block w-full" {{ responsive_image(fields.before) }} alt="{{ fields.label_before }}"/>
				{% endif %}

				{% if fields.after %}
					<div class="before-after__after">
						<img class="lazyload block size-full object-cover" {{ responsive_image(fields.after) }} alt="{{ fields.label_after }}"/>
					</div>
				{% endif %}

				<span class="before-after__line" aria-hidden="true"></span>

				<button type="button" class="before-after__handle" aria-label="{{ fields.label_before }} / {{ fields.label_after }}">
					<svg class="before-after__arrows" viewBox="0 0 48 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M16 3 10 8l6 5"/>
						<path d="M32 3l6 5-6 5"/>
					</svg>
				</button>
			</div>
		</div>
	</div>
</section>
