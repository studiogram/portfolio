<section {{ block_id }} data-block-type="img" data-block-id="{{ block.id }}" class="{{ block_classes(fields) }}">
	{% include 'views/partials/block/borders.twig' %}
	<div class="content-grid content-grid--{{fields.space.large}}">
		{% if fields.image %}
			{{ include('views/components/reveal-image/view.twig', { image: fields.image, blend: fields.multiply ? theme : null, class: '' }) }}
		{% endif %}
	</div>
</section>
