<section {{ block_id }} data-block-type="columns" data-block-id="{{ block.id }}">
	<div class="col-span-10 col-start-2! flex flex-wrap justify-center gap-8 lg:col-span-20 lg:col-start-3!">
		{% for column in fields.columns %}
			{% if column.width%}
				<article class="flex w-full justify-center pb-8 overflow-hidden">
					<div class="flex w-full items-center gap-8 lg:w-[60%]">
						<figure class="w-26! overflow-hidden shrink-0">
							<img data-scroll="from-left-full" class="lazyload" {{ responsive_image(column.forme) }}/>
						</figure>

						<div>
							<h3 class="text-{{column.color}}! font-bold pb-2! text-md">{{ column.title }}</h3>
							<div class="wysiwyg">{{ column.text }}</div>
						</div>
					</div>
				</article>
			{% else %}
				<article class="flex w-full flex-col items-start gap-8 pb-8 lg:w-[calc(25%-1.5rem)] overflow-hidden">
					<figure class="w-30! overflow-hidden">
						<img data-scroll="from-left-full" class="lazyload" {{ responsive_image(column.forme) }}/>
					</figure>

					<div>
						<h3 class="text-{{column.color}}! font-bold pb-2! text-md">{{ column.title }}</h3>
						<div class="wysiwyg">{{ column.text }}</div>
					</div>
				</article>
			{% endif %}
		{% endfor %}
	</div>
</section>
