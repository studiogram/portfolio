{% set type = fields.header_type %}

{% set minHeights = {
	'text': admin ? 'lg:min-h-[200px]' : 'lg:min-h-[300px]',
	'text-img': admin ? 'lg:min-h-[600px]' : 'lg:min-h-[700px]',
	'text-shape': admin ? 'lg:min-h-[400px]' : 'lg:min-h-[500px]',
	'solution': admin ? 'lg:min-h-[400px]' : 'lg:min-h-[500px]'
} %}

{% set cols = (type == 'text-shape') ? 'lg:col-span-15' : 'lg:col-span-14' %}

<header {{ block_id }} data-block-type="header" data-block-id="{{ block.id }}" class="header--{{type}} | p-0! mb-16! {% if type == 'solution' %} bg-{{fields.color}} rounded-b-4xl{% else %} mb-0! {% endif %} relative">
	<div class="grider items-end w-full h-full relative {% if type != 'text-shape' %} overflow-hidden {% endif %} {% if type == 'solution' %} pb-8 lg:pb-16 {% else %} pb-6 {% endif %} ">
		{% if type == 'text-img' %}
			{{ include('views/components/reveal-image/view.twig', { image: fields.image, blend: fields.multiply ? theme : null, class: 'mt-16 lg:mt-0 lg:absolute lg:top-0 lg:right-0 lg:w-auto! lg:h-2/3! xl:h-full!' }) }}
		{% endif %}

		{% if type == 'text-shape' %}
			{{ include('views/components/shape/view.twig', {
				shape: fields.shape,
				from: theme == 'dark' ? 'dark' : 'white',
				to: fields.color,
				angle: '135deg',
				class: 'pointer-events-none absolute top-1/2 -translate-y-1/2! bottom-12 left-[55%] w-1/2! z-0 mix-blend-multiply'
        	}) }}
		{% elseif type == 'solution' %}
			{{ include('views/components/solution-shape/view.twig', {
				shape: fields.shape,
				color: fields.color,
				class: 'pointer-events-none absolute top-0 left-0 lg:left-1/2 w-full lg:w-1/2! z-0'
        	}) }}
			{{ include('views/components/solution-shape/view.twig', {
				shape: 'e',
				color: fields.color,
				class: 'pointer-events-none absolute bottom-0 right-0 w-full lg:w-[45%]! z-20'
        	}) }}
		{% endif %}


		<div class="wysiwyg justify-end relative z-10 col-span-12 col-start-1! lg:col-start-2! pt-32 {{cols}} {{ minHeights[type] }}">
			{% if type == 'solution' %}
				{{ include('views/components/tag/view.twig', { tag: {text: content.solution.text, url: content.solution.page}, bg: 'lightgreen', color: fields.color }) }}
			{% endif %}
			{{ fields.text }}
		</div>

		{% if type == 'solution' %}
			<figure class="relative z-10 col-span-12 lg:col-span-7 col-start-1! lg:col-start-17! rounded-4xl overflow-hidden mt-12! lg:mt-32!">
				{{ include('views/components/reveal-image/view.twig', { image: fields.image }) }}
			</figure>
		{% endif %}
	</div>

	{% if type == 'solution' %}
		{{ include('views/components/header-arrow/view.twig', {class: 'absolute bottom-0 left-2/12 z-50 -translate-x-1/2! translate-y-1/2!', rotate: '-rotate-45'}) }}
	{% endif %}
</header>
