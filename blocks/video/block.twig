<section {{ block_id }} data-block-type="video" data-block-id="{{ block.id }}" class="{{ block_classes(fields) }}">
	{% include 'views/partials/block/borders.twig' %}
	<div class="content-grid content-grid--{{fields.space.large}}">
		<figure class="relative w-full max-w-4xl justify-self-center text-center">
			<div class="video__frame rounded-3xl relative overflow-hidden">
				<video class="video__player" playsinline muted loop preload="metadata">
					<source src="{{ fields.video }}#t=0.001" type="video/mp4"/>
				</video>
			</div>
		</figure>
	</div>
</section>
