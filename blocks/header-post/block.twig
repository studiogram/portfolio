<section {{ block_id }} data-block-type="text" data-block-id="{{ block.id }}" class="{{ block_classes(fields, true) }}">
	<div class="wysiwyg content-grid content-grid--{{fields.space.large}}">
		{% if pastille %}<span data-pastille class="inline-block w-5 h-5 rounded-full bg-{{ pastille }}"></span>{% endif %}
		{{ fields.text }}
	</div>
</section>
