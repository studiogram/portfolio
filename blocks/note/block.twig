<section {{ block_id }} data-block-type="note" data-block-id="{{ block.id }}" class="{{ block_classes(fields) }}">
	{% include 'views/partials/block/borders.twig' %}
	{% if fields.note %}
		<div class="content-grid">
			<div class="notes__sheet rounded-3xl">
				<div class="notes__list">
					{% include 'views/partials/notes/row.twig' with { note: fields.note } only %}
				</div>
			</div>
		</div>
	{% endif %}
</section>
