<section {{ block_id }} data-block-type="header-approche" data-block-id="{{ block.id }}" class="{{ block_classes(fields, true) }}">
	<div class="col-span-12 flex flex-col items-center gap-6 px-6! pb-12 text-center lg:col-span-24 lg:gap-12 lg:px-0! lg:pb-20">
		{% if fields.title %}<h1 class="max-w-[22ch]" data-effect="headline">{{ fields.title }}</h1>{% endif %}
		{% if fields.intro %}<div class="wysiwyg max-w-130">{{ fields.intro }}</div>{% endif %}
	</div>
</section>
