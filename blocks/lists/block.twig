<section {{ block_id }} data-block-type="lists" data-block-id="{{ block.id }}" class="{{ block_classes(fields) }} lists relative">
	{% include 'views/partials/block/borders.twig' %}

	<div class="col-span-12 flex flex-col items-center gap-12 px-6! text-center lg:col-span-20 lg:col-start-3 lg:gap-20 lg:px-0!">
		{% if fields.title %}<h2 class="text-xxl max-w-[16ch]">{{ fields.title }}</h2>{% endif %}

		{% if fields.columns %}
			{% set cols = [] %}
			{% for col in fields.columns %}
				{% set cols = cols|merge([{ heading: col.heading, lines: col.items|split('\n') }]) %}
			{% endfor %}
			{% include 'views/components/listing/view.twig' with { columns: cols, class: 'listing--rule w-full grid-cols-2 text-left sm:grid-cols-3 lg:grid-cols-5', body_gap: 'gap-0' } %}
		{% endif %}

		{% if fields.footer %}<p class="mt-32! max-w-[40ch] text-xl">{{ fields.footer }}</p>{% endif %}
	</div>
</section>
