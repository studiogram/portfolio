<section {{ block_id }} data-block-type="lists" data-block-id="{{ block.id }}" class="{{ block_classes(fields) }} lists relative">
	{% include 'views/partials/block/borders.twig' %}

	<div class="col-span-12 flex flex-col items-center gap-12 px-6! text-center lg:col-span-20 lg:col-start-3 lg:gap-20 lg:px-0!">
		{% if fields.title %}<h2 class="text-xxl max-w-[16ch]">{{ fields.title }}</h2>{% endif %}

		{% if fields.columns %}
			<div class="grid w-full grid-cols-2 gap-x-8 gap-y-10 text-left sm:grid-cols-3 lg:grid-cols-5 lg:gap-x-6">
				{% for col in fields.columns %}
					<div class="flex flex-col gap-4">
						{% if col.heading %}<h3 class="text-xxs text-medium-tertiary uppercase">{{ col.heading }}</h3>{% endif %}
						<hr class="border-dark/15 border-t"/>
						{% if col.items %}
							<ul class="flex flex-col gap-3">
								{% for item in col.items|split('\n') %}
									{% if item|trim %}<li class="text-xxs">{{ item|trim }}</li>{% endif %}
								{% endfor %}
							</ul>
						{% endif %}
					</div>
				{% endfor %}
			</div>
		{% endif %}

		{% if fields.footer %}<p class="max-w-[40ch] text-xl">{{ fields.footer }}</p>{% endif %}
	</div>
</section>
