<div class="contact spacing--top | bg-medium rounded--bottom relative z-10 overflow-hidden rounded text-center">
	<div class="-mb-16 flex flex-col items-center gap-8">
		{% if show_contact is not same as(false) %}
			<div class="wysiwyg">
				{{ contact.description }}
			</div>
		{% endif %}
		{{ include('views/components/button/view.twig', {button: contact.btn}) }}
	</div>
	{{ include('views/svg/footer.twig') }}
</div>
