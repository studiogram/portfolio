<div class="contact {% if show_contact ?? true %} spacing--top {% endif %} | bg-medium rounded--bottom relative z-10 overflow-hidden rounded text-center">
	{% if show_contact ?? true %}
		<div class="flex w- flex-col items-center gap-8 lg:-mb-16">
			<div class="wysiwyg">
				{{ contact.description }}
			</div>
			{{ include('views/components/button/view.twig', {button: contact.btn}) }}
		</div>
	{% endif %}
	{{ include('views/svg/footer.twig', {class: "w-[200%]! -left-1/4 lg:w-full! lg:left-0"}) }}
</div>
