{# Literal classes so Tailwind's scanner emits them — interpolated
   `lg:col-span-{{ span }}` is invisible to the JIT build. #}
{% set spans = {
	1: 'lg:col-span-1',
	2: 'lg:col-span-2',
	3: 'lg:col-span-3',
	4: 'lg:col-span-4',
	5: 'lg:col-span-5',
	6: 'lg:col-span-6'
} %}
{% for post in posts %}
	<div class="archive__item | col-span-1 {{ spans[post.span] ?? 'lg:col-span-2' }}">
		{{ include('views/components/post-card/view.twig', { id: post.id }) }}
	</div>
{% endfor %}
