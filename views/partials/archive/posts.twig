{% for post in posts %}
	{% set term = post.terms('category')|first %}
	{% set color = term ? (function('get_field', 'color', 'category_' ~ term.id) ?: 'dark') : 'dark' %}
	<article class="archive__item group relative">
		<a href="{{ post.link }}" class="flex flex-col gap-6 lg:flex-row lg:items-stretch lg:gap-16">
			<figure class="relative shrink-0 self-start overflow-hidden rounded-xl bg-medium-secondary lg:w-1/2">
				<div class="aspect-[8/5] w-full">
					{% if post.thumbnail %}
						<img class="lazyload size-full object-cover" {{ responsive_image(post.thumbnail.id) }}/>
					{% else %}
						<span class="flex size-full items-center justify-center text-[92px] text-dark/30">{{ post.title|slice(0, 1) }}</span>
					{% endif %}
				</div>
			</figure>

			<div class="flex flex-1 flex-col justify-center gap-5 lg:py-10">
				{% if term %}
					<span class="text-s inline-flex items-center gap-2.5 uppercase text-{{ color }}">
						<span class="size-3 shrink-0 rounded-full bg-{{ color }}"></span>
						{{ term.name }}
					</span>
				{% endif %}
				<h2 class="text-xxl text-dark">{{ post.title }}</h2>
				<span aria-hidden="true" class="mt-2 flex size-12 items-center justify-center rounded-full bg-{{ color }} transition-transform duration-300 group-hover:translate-x-1 lg:ml-auto">
					<svg class="w-5" viewBox="0 0 24 24" fill="none" stroke="#20172e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
				</span>
			</div>
		</a>
	</article>
{% endfor %}
