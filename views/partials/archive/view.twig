<header class="pt-12 pb-8">
	<div class="flex flex-col lg:flex-row lg:items-center lg:justify-start gap-4 mb-8">
		<div class="py-2">
			<span class="text-xld">{{ content.texts.oneflux ?? 'Articles' }}</span>
		</div>

		<div class="archive__divider hidden lg:block"></div>

		<h1 data-title data-effect="headline" class="archive__title font-bold text-l{{ archive.category_title ? '' : ' hidden' }}">{{ archive.category_title }}</h1>
	</div>


	<ul class="archive__categories | flex flex-wrap gap-3 relative">
		<li>
			<a href="{{ archive.url }}" data-cat="0" data-taxi-ignore class="archive__cat{{ archive.current_cat ? '' : ' is-active' }}">{{content.texts.all}}</a>
		</li>
		{% for cat in archive.categories %}
			<li>
				<a href="{{ cat.url }}" data-cat="{{ cat.id }}" data-taxi-ignore class="archive__cat{{ cat.id == archive.current_cat ? ' is-active' : '' }}">{{ cat.title }}</a>
			</li>
		{% endfor %}
	</ul>
</header>


<div data-component="load-more" data-cat="{{ archive.current_cat }}" class="relative">

	<div class="archive__grid | grid grid-cols-1 gap-6 lg:grid-cols-6" data-grid>
		{% include 'views/partials/archive/posts.twig' with { posts: archive.posts } %}
	</div>

	<div class="archive__loader" data-loader hidden></div>

	<button type="button" class="archive__more" data-load-more-btn {{ archive.has_more ? '' : ' hidden' }}>Charger plus</button>
</div>
