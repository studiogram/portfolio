<footer class="footer | bg-light">
	<div class="footer__content | grider">
		<div class="content-grid">
			<a href="{{ home }}" class="footer__logo" aria-label="{{ site.name }}">
				{# {{ include('views/svg/logo.twig') }} #}
			</a>

			{% if footer_menu %}
				<nav aria-label="{{ site.name }}">
					<ul class="flex flex-col gap-4 lg:flex-row lg:gap-8">
						{% for item in footer_menu.items %}
							<li><a class="a" href="{{ item.link }}">{{ item.title }}</a></li>
						{% endfor %}
					</ul>
				</nav>
			{% endif %}

			<p class="text-xs">© {{ "now"|date("Y") }} {{ site.name }}</p>
		</div>
	</div>
</footer>
