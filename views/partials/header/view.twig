<header id="header" class="fixed inset-x-0 top-4 mx-4 lg:mx-8">

	<div class="relative flex items-center justify-between px-4! lg:px-8! py-2">
		<a href="{{ home }}" class="header__logo | py-4" aria-label="{{ site.name }}">
			{{ include('views/svg/logo.twig') }}
		</a>

		{# <button class="burger lg:hidden!" data-isopen="false" aria-label="Menu">{{ include('views/svg/burger.twig') }}</button> #}

		{% if header.pages %}
			<nav class="header__nav | hidden lg:flex gap-6 items-center text-m" aria-label="{{ site.name }}">
				<ul>
					{% for item in header.pages %}
						<li><a class="header__link {{ item.current ? 'is-current' : '' }}" href="{{ item.page }}">{{ item.text }}</a></li>
					{% endfor %}
					<li>{{ include('views/components/button/view.twig', {button: header.btn}) }}</li>
				</ul>
			</nav>
		{% endif %}
	</div>
</header>
