<hr class="header__scrim" aria-hidden="true"/>
<header class="header {{ theme == 'dark' ? 'is-on-dark' : '' }} | grider fixed inset-x-0">

	<div class="relative col-start-2 col-end-12 flex items-center justify-between py-2 lg:col-end-24">
		<a href="{{ home }}" class="header__logo | py-4" aria-label="{{ site.name }}" data-header-ctx="{{ theme_for(home) }}">
			{{ include('views/svg/logo-gram.twig') }}
		</a>

		<button class="burger" data-isopen="false" aria-label="Menu" aria-expanded="false" aria-controls="header-nav">
			<span class="burger__label">Menu</span>
			{{ include('views/svg/burger.twig') }}
		</button>

		{% if header.pages %}
			<nav id="header-nav" class="header__nav" aria-label="Menu principal">
				<ul class="flex flex-col gap-6">
					{% for item in header.pages %}
						<li><a class="header__link {{ item.current ? 'is-current' : '' }} text-s" href="{{ item.page }}"{{ item.current ? ' aria-current="page"' : '' }} data-header-ctx="{{ theme_for(item.page) }}">{{ item.text }}</a></li>
					{% endfor %}
					<li>{{ include('views/components/button/view.twig', {button: header.btn|merge({ ctx: theme_for(header.btn.interne) })}) }}</li>
				</ul>

				{% if header.email or header.text %}
					<div class="header__contact | mt-12 flex flex-col gap-3 lg:hidden">
						{% if header.email %}
							<a href="mailto:{{ header.email|antispam }}" class="text-soft-light text-l">{{ header.email|antispam }}</a>
						{% endif %}
						{% if header.text %}<div class="wysiwyg text-soft text-s">{{ header.text }}</div>{% endif %}
					</div>
				{% endif %}
			</nav>
		{% endif %}
	</div>
</header>
