{% set size = tag.size|default('s') %}
{% set url = tag.url %}
{% set class = 'inline-block rounded-4xl px-3 py-1 text-' ~ size ~ ' ' ~ tag.class %}
{% if url %}
	<a href="{{ url }}" data-theme="{{ theme_for(url) }}" class="{{ class }} pointer-events-auto transition-colors duration-300 self-start border-2 border-{{bg}} bg-{{bg}}! text-{{color}}! hover:bg-{{color}}! hover:text-{{bg}}!" {% if target %} target="{{ target }}" rel="noopener" {% endif %}>{{ tag.text }}</a>
{% else %}
	<span class="{{ class }} inline-block pointer-events-none self-start border-2 border-transparent">{{ tag.text }}</span>
{% endif %}
