{% if button.text %}
	{% set anchor = button.identifiant ? '#' ~ button.identifiant : '' %}
	{% set types = {
		interne: {href: button.interne ~ anchor},
		externe: {href: button.externe, target: '_blank'},
		file: {href: button.file, target: '_blank', download: true},
		calendar: {href: '#calendar'}
	} %}
	{% set type = types[button.type] %}
	{% if type %}
		<a class="btn{{ button.variant ? ' btn--' ~ button.variant }}{{ button.align and button.align != 'left' ? ' btn--' ~ button.align }}{{ button.class ? ' ' ~ button.class }}" href="{{ type.href }}"{{ type.target ? ' target="' ~ type.target ~ '"' }}{{ type.download ? ' download' }}>
			<span>{{ button.text }}</span>
		</a>
	{% endif %}
{% endif %}
