{% set src = function('wp_get_attachment_image_src', image, 'xl') %}
{% if src %}
	{% set url = src[0] %}
	{% set dims = image_dimensions(image) %}
	{% set w = dims[0] %}
	{% set h = dims[1] %}
	{% set alt = function('get_post_meta', image, '_wp_attachment_image_alt', true) %}
	{% set uid = 'reveal-' ~ image ~ '-' ~ random(99999) %}
	{% if function('is_admin') or function('wp_is_mobile') %}
		<img class="{{ class }}" src="{{ url }}" alt="{{ alt }}"/>
	{% else %}
		<svg class="reveal-image {{ class }}" viewbox="0 0 {{ w }} {{ h }}" preserveaspectratio="xMidYMid slice" role="img" aria-label="{{ alt }}">
			<defs>
				{% set is_mobile = function('wp_is_mobile') %}
				<filter id="{{ uid }}-turb" x="-60%" y="-60%" width="220%" height="220%">
					<feTurbulence type="fractalNoise" basefrequency="0.009" numoctaves="{{ is_mobile ? 2 : 4 }}" seed="7" result="noise"/>
					<feDisplacementMap in="SourceGraphic" in2="noise" scale="{{ is_mobile ? 130 : 260 }}" xchannelselector="R" ychannelselector="G" result="displaced"/>
					<feGaussianBlur in="displaced" stddeviation="10"/>
				</filter>
				<mask id="{{ uid }}-mask">
					<circle {% if smart %} data-reveal-circle-smart {% else %} data-reveal-circle {% endif %} cx="{{ w / 2 }}" cy="{{ h / 2 }}" r="{{ w + h }}" fill="#fff" filter="url(#{{ uid }}-turb)"/>
				</mask>
			</defs>
			<image href="{{ url }}" x="0" y="0" width="{{ w }}" height="{{ h }}" preserveaspectratio="xMidYMid slice" mask="url(#{{ uid }}-mask)"/>
		</svg>
	{% endif %}
{% endif %}
