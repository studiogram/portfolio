{# Radial gradient for shapes. id - unique gradient id (required, must match the fill url in the shape) from - color token at the origin point (default: dark) to - color token at the outer edge (default: white) x - horizontal origin, % of shape box (default: 0% = left) y - vertical origin, % of
shape box (default: 0% = top) r - radius, fraction of shape box (default: 1 ≈ far corner) var() is unsupported in SVG presentation attributes, so stops use inline style. #}
{% set hex = { 'dark': '#030e21', 'blue': '#00394c', 'lightblue': '#9bd7eb', 'lighterblue': '#d8e3f6', 'purple': '#453989', 'orange': '#e26643', 'green': '#015c52', 'lightgreen': '#ade0da', 'grey': '#e8e8e9', 'darkgrey': '#bbbec1', 'lightgrey': '#f3f3f3', 'white': '#ffffff' } %}
{% set fromc = hex[from|default('dark')] ?? ('var(--color-' ~ (from|default('dark')) ~ ')') %}
{% set toc = hex[to|default('white')] ?? ('var(--color-' ~ (to|default('white')) ~ ')') %}
{% if (type|default('radial')) == 'linear' %}
<linearGradient id="{{ id }}" x1="{{ x1|default('0%') }}" y1="{{ y1|default('0%') }}" x2="{{ x2|default('100%') }}" y2="{{ y2|default('100%') }}">
    <stop offset="0%" style="stop-color: {{ fromc }}" />
    <stop offset="100%" style="stop-color: {{ toc }}" />
</linearGradient>
{% else %}
<radialGradient id="{{ id }}" cx="{{ x|default('0%') }}" cy="{{ y|default('0%') }}" r="{{ r|default('1') }}">
    <stop offset="0%" style="stop-color: {{ fromc }}" />
    <stop offset="100%" style="stop-color: {{ toc }}" />
</radialGradient>
{% endif %}
