<!DOCTYPE html>
<html {{ site.language_attributes }}>

    <head>
        <script>
            document.documentElement.classList.add("js");
        </script>
        <meta charset="{{ site.charset }}"/>
        <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
        <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <link rel="pingback" href="{{ site.pingback_url }}"/>
        <link rel="profile" href="http://gmpg.org/xfn/11"/>
        {{ function('wp_head') }} {% include 'partials/meta/view.twig' %}
    </head>

    <body class="{{ body_class }} bg-light">
        {% include 'partials/header/view.twig' %}
        <div data-taxi>
            <div data-taxi-view {% if post and post.post_type in ['post', 'page'] %} data-post-id="{{ post.id }}" {% endif %}>
                {% block content %} Sorry, no content {% endblock %}
            </div>
        </div>
        {% include 'partials/contact/view.twig' %}
        {% include 'partials/footer/view.twig' %}
        {{ function('wp_footer') }}
    </body>

</html>
