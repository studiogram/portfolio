{% extends 'views/layouts/base.twig' %}

{% block content %}
	<div data-component="archive-filter" data-template="archive" data-default-title="{{ archive.hero_title }}">
		<header class="archive-hero relative rounded-b-[3rem] bg-medium pt-28 pb-0 lg:pt-32">
			<div class="archive-hero__cartouche relative flex flex-col gap-6 overflow-hidden rounded-[2.25rem] px-6 py-12 lg:flex-row lg:items-center lg:justify-between lg:gap-16 lg:px-20 lg:py-16"{% if archive.cartouche.color %} data-color="{{ archive.cartouche.color }}"{% endif %}>
				<span class="archive-hero__dot" aria-hidden="true"></span>
				<span class="archive-hero__dot archive-hero__dot--right" aria-hidden="true"></span>
				<h1 data-effect="none" class="archive-hero__title" data-hero-title><span class="archive-hero__titleinner" data-hero-inner>{{ archive.cartouche.title }}</span></h1>
				{% if archive.hero_subtitle %}
					<p class="archive-hero__text text-m max-w-xl">{{ archive.hero_subtitle }}</p>
				{% endif %}
			</div>

			<div class="archive__filterbar">
				{% if archive.filter_label %}
					<span class="archive__filterlabel text-s uppercase text-dark">{{ archive.filter_label }}</span>
				{% endif %}

				<ul class="archive__categories">
					{% for cat in archive.categories %}
						<li>
							<a href="{{ cat.url }}" data-cat="{{ cat.id }}" data-color="{{ cat.color }}" data-taxi-ignore
								style="--pill: var(--color-{{ cat.color }}); --pill-text: var(--color-{{ cat.text_color }});"
								class="archive__cat{{ cat.id == archive.current_cat ? ' is-active' : '' }}">{{ cat.title }}</a>
						</li>
					{% endfor %}
					<li>
						<a href="{{ archive.url }}" data-cat="0" data-taxi-ignore
							style="--pill: var(--color-dark); --pill-text: var(--color-light);"
							class="archive__cat{{ archive.current_cat ? '' : ' is-active' }}">Tous</a>
					</li>
				</ul>

				<select class="archive__select" data-cat-select aria-label="{{ archive.filter_label|default('Filtrer par secteur') }}">
					<option value="0" data-color=""{{ archive.current_cat ? '' : ' selected' }}>Tous</option>
					{% for cat in archive.categories %}
						<option value="{{ cat.id }}" data-color="{{ cat.color }}"{{ cat.id == archive.current_cat ? ' selected' : '' }}>{{ cat.title }}</option>
					{% endfor %}
				</select>
			</div>
		</header>

		<main class="mx-auto max-w-[1600px] px-6 py-20 lg:px-8 lg:py-28">
			<div class="relative">
				<div class="archive__grid flex flex-col gap-16 lg:gap-28" data-grid>
					{% include 'views/partials/archive/posts.twig' with { posts: archive.posts } %}
				</div>

				<div class="archive__loader" data-loader hidden></div>
			</div>
		</main>
	</div>
{% endblock %}
