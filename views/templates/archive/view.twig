{% extends 'views/layouts/base.twig' %}

{% block content %}
	<div data-component="archive-filter" data-template="archive" data-default-title="{{ archive.hero_title }}">
		<header class="archive-hero relative">
			<div class="archive-hero__cartouche text-light relative flex flex-col gap-6 overflow-hidden rounded-b-m px-6 pt-36 pb-14 lg:flex-row lg:items-center lg:justify-between lg:gap-16 lg:px-20 lg:pt-30 lg:pb-12" data-header-dark{% if archive.cartouche.color %} data-color="{{ archive.cartouche.color }}"{% endif %}>
				<h1 data-effect="none" class="archive-hero__title" data-hero-title>
					<span class="archive-hero__titleinner lg:pl-11!" data-hero-inner>{{ archive.cartouche.title }}</span>
				</h1>
				{% if archive.hero_subtitle %}
					<p class="archive-hero__text text-m max-w-xl">{{ archive.hero_subtitle }}</p>
				{% endif %}
			</div>

			<div class="archive__filterbar">
				{% if archive.filter_label %}
					<span class="archive__filterlabel text-s text-dark">{{ archive.filter_label }}</span>
				{% endif %}

				<ul class="archive__categories">
					{% for cat in archive.categories %}
						<li>
							<a
								href="{{ cat.url }}"
								data-cat="{{ cat.id }}"
								data-color="{{ cat.color }}"
								data-taxi-ignore
								style="--pill: var(--color-{{ cat.color }}); --pill-text: var(--color-{{ cat.text_color }});"
								class="archive__cat{{ cat.id == archive.current_cat ? ' is-active' : '' }}"
							>{{ cat.title }}</a>
						</li>
					{% endfor %}
					<li>
						<a
							href="{{ archive.url }}"
							data-cat="0"
							data-taxi-ignore
							style="--pill: var(--color-dark); --pill-text: var(--color-light);"
							class="archive__cat{{ archive.current_cat ? '' : ' is-active' }}"
						>Tous</a>
					</li>
				</ul>

				<select class="archive__select" data-cat-select aria-label="{{ archive.filter_label|default('Filtrer par secteur') }}">
					<option value="0" data-color=""{{ archive.current_cat ? '' : ' selected' }}>Tous</option>
					{% for cat in archive.categories %}
						<option value="{{ cat.id }}" data-color="{{ cat.color }}"{{ cat.id == archive.current_cat ? ' selected' : '' }}>{{ cat.title }}</option>
					{% endfor %}
				</select>
			</div>
		</header>

		<main class="grider py-32 lg:py-44">
			<div class="relative col-span-10 col-start-2 lg:col-span-22 lg:col-start-2">
				<div class="archive__grid mx-auto flex max-w-375 flex-col gap-16 lg:gap-28" data-grid>
					{% include 'views/partials/archive/posts.twig' with { posts: archive.posts } %}
				</div>
			</div>
		</main>
	</div>
{% endblock %}
