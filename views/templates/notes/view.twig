{% extends 'views/layouts/base.twig' %}

{% block content %}
	<section class="notes bg-medium" data-component="notes-archive">
		<header class="notes__head">
			<div class="notes__grid">
				<div class="notes__cartouche col-start-1 col-end-13 lg:col-start-2 lg:col-end-24">
					{% if notes_archive.title %}<h1 class="notes__title" data-effect="none">{{ notes_archive.title }}</h1>{% endif %}
					{% if notes_archive.description %}<div class="notes__desc">{{ notes_archive.description|raw }}</div>{% endif %}
				</div>
			</div>
		</header>

		<div class="notes__body">
			<div class="notes__grid">
				<div class="notes__sheet col-start-2 col-end-12 lg:col-start-3 lg:col-end-23">
					<div class="notes__list" data-notes-list>
						{% include 'views/partials/notes/rows.twig' with { notes: notes_archive.notes } %}
					</div>
				</div>
			</div>

			{% if notes_archive.pages > 1 %}
				<nav class="notes__pagination" aria-label="Pagination">
					{% for i in 1..notes_archive.pages %}
						<button type="button" class="notes__page{{ i == 1 ? ' is-active' : '' }}" data-page="{{ i }}">{{ i }}</button>
					{% endfor %}
				</nav>
			{% endif %}
		</div>
	</section>
{% endblock %}
